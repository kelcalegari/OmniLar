{
  "hosting": {
    "site": "omnilar",
    "public": "build/web",
    "redirects": [
      {
        "source": "/apk",
        "destination": "https://rygxmpwzofgieodvhpcy.supabase.co/storage/v1/object/public/releases/OmniLar-arm64-release.apk",
        "type": 302
      },
      {
        "source": "/download",
        "destination": "https://rygxmpwzofgieodvhpcy.supabase.co/storage/v1/object/public/releases/OmniLar-arm64-release.apk",
        "type": 302
      }
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/!(*.*)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/{index.html,main.dart.js,flutter_bootstrap.js,version.json,manifest.json}",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/{assets,canvaskit}/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      },
      {
        "source": "/{icons/**,favicon.png,apple-touch-icon*.png}",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
